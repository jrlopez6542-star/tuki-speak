rules_version = '2';

// Tuki Speak: cada persona solo puede leer y escribir su propio documento.
// Plan Spark: sin Cloud Functions ni Storage. Todo lo demás está denegado.
// quota/*: contadores de las claves compartidas, escritos solo por la cuenta de servidor (v2.10); solo el dueño los lee (v2.11).
// profiles/*: perfil mínimo de cada cuenta (lo escribe cada quien, solo el dueño lo lee). feedback/*: comentarios (v2.11).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isTime(v) {
      return v is timestamp || (v is number && v >= 0 && v < 100000000000000);
    }

    function strMax(v, n) {
      return v is string && v.size() <= n;
    }

    // Dueño de la app (panel de administrador, v2.11)
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'jrlopez6542@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Correo del token (cadena vacía si la cuenta no tiene correo)
    function tokenEmail() {
      return request.auth.token.get('email', '');
    }

    // profiles/{uid}: nombre, correo, método, primer ingreso, última actividad, versión y modo (claves propias o de Tuki)
    function validProfile(d) {
      return d.keys().hasOnly(['name', 'email', 'provider', 'firstSeen', 'lastActive', 'app', 'mode'])
        && d.keys().hasAll(['name', 'email', 'provider', 'firstSeen', 'lastActive', 'app'])
        && strMax(d.name, 100)
        && d.email == tokenEmail()
        && d.provider in ['google.com', 'password']
        && d.firstSeen is timestamp
        && d.lastActive == request.time
        && strMax(d.app, 20)
        && (!('mode' in d) || d.mode in ['own', 'shared']);
    }

    // feedback/{id}: estrellas 1–5 y texto de hasta 1000 caracteres, siempre con el uid y correo propios
    function validFeedback(d) {
      return d.keys().hasOnly(['uid', 'email', 'name', 'stars', 'text', 'version', 'createdAt'])
        && d.keys().hasAll(['uid', 'email', 'name', 'stars', 'text', 'version', 'createdAt'])
        && d.uid == request.auth.uid
        && d.email == tokenEmail()
        && strMax(d.name, 100)
        && d.stars is int && d.stars >= 1 && d.stars <= 5
        && strMax(d.text, 1000)
        && strMax(d.version, 20)
        && d.createdAt == request.time;
    }

    // keysEnc: null (sin claves) o el sobre AES-GCM {v, alg, salt, iv, ct, iter}
    function validKeysEnc(k) {
      return k == null || (
        k is map
        && k.keys().hasOnly(['v', 'alg', 'salt', 'iv', 'ct', 'iter'])
        && k.keys().hasAll(['v', 'salt', 'iv', 'ct', 'iter'])
        && k.v is int && k.v >= 1 && k.v <= 10
        && k.salt is string && k.salt.size() >= 16 && k.salt.size() <= 64
        && k.iv is string && k.iv.size() >= 12 && k.iv.size() <= 32
        && k.ct is string && k.ct.size() >= 1 && k.ct.size() <= 8192
        && k.iter is int && k.iter >= 310000 && k.iter <= 5000000
        && (!('alg' in k) || strMax(k.alg, 64))
      );
    }

    function validMeta(d) {
      return d.keys().hasOnly(['schemaVersion', 'updatedAt', 'keysEnc', 'device', 'progressSize', 'app'])
        && d.keys().hasAll(['schemaVersion', 'updatedAt'])
        && d.schemaVersion is int && d.schemaVersion >= 1 && d.schemaVersion <= 100
        && isTime(d.updatedAt)
        && (!('keysEnc' in d) || validKeysEnc(d.keysEnc))
        && (!('device' in d) || strMax(d.device, 80))
        && (!('progressSize' in d) || (d.progressSize is int && d.progressSize >= 0 && d.progressSize <= 20000000))
        && (!('app' in d) || strMax(d.app, 40));
    }

    function validProgress(d) {
      return d.keys().hasOnly(['z', 'enc', 'n', 'updatedAt'])
        && d.keys().hasAll(['z', 'enc', 'updatedAt'])
        && d.z is string && d.z.size() <= 1000000
        && d.enc in ['TK1', 'TK0']
        && (!('n' in d) || (d.n is int && d.n >= 0 && d.n <= 20000000))
        && isTime(d.updatedAt);
    }

    // Ajustes sin claves de API (las claves solo viajan cifradas en keysEnc)
    function validSettings(d) {
      return d.keys().hasOnly(['s', 'updatedAt'])
        && d.keys().hasAll(['s', 'updatedAt'])
        && d.s is map && d.s.size() <= 200
        && !d.s.keys().hasAny(['geminiKey', 'openaiKey', 'azureKey', 'apiKey', 'token'])
        && isTime(d.updatedAt);
    }

    match /users/{uid} {
      allow get: if signedInAs(uid);
      allow list: if false;
      allow create, update: if signedInAs(uid) && validMeta(request.resource.data);
      allow delete: if signedInAs(uid);

      match /data/{docId} {
        allow get: if signedInAs(uid) && docId in ['progress', 'settings'];
        allow list: if false;
        allow create, update: if signedInAs(uid) && (
          (docId == 'progress' && validProgress(request.resource.data)) ||
          (docId == 'settings' && validSettings(request.resource.data))
        );
        allow delete: if signedInAs(uid) && docId in ['progress', 'settings'];
      }
    }

    // v2.10 «claves compartidas»: contadores diarios de uso gratis (quota/{día}_{uid}).
    // Solo los escribe la cuenta de servidor de la API de Vercel; solo el dueño los lee (panel, v2.11); nadie los borra.
    match /quota/{docId} {
      allow create, update: if request.auth != null
        && request.auth.uid == 'R9hBV7CgH1geEUyZZT7wBkrIoE92'
        && docId.size() <= 160
        && request.resource.data.keys().hasOnly(['gemini', 'live', 'azure', 'updatedAt'])
        && (!('gemini' in request.resource.data) || request.resource.data.gemini is int)
        && (!('live' in request.resource.data) || request.resource.data.live is int)
        && (!('azure' in request.resource.data) || request.resource.data.azure is int)
        && request.resource.data.updatedAt is timestamp;
      allow read: if isOwner();
      allow delete: if false;
    }

    // v2.11: perfil de cada cuenta. Cada quien crea/actualiza solo el suyo (firstSeen no cambia); solo el dueño lee y lista.
    match /profiles/{uid} {
      allow create: if signedInAs(uid) && validProfile(request.resource.data)
        && request.resource.data.firstSeen == request.time;
      allow update: if signedInAs(uid) && validProfile(request.resource.data)
        && request.resource.data.firstSeen == resource.data.firstSeen;
      allow read: if isOwner();
      allow delete: if false;
    }

    // v2.11: comentarios. Cualquier cuenta crea con su propio uid; nadie los edita; solo el dueño lee, lista y borra.
    match /feedback/{id} {
      allow create: if request.auth != null && validFeedback(request.resource.data);
      allow read, delete: if isOwner();
      allow update: if false;
    }

    // Todo lo demás: denegado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
